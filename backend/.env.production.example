# Production Environment Variables for Confidometer Backend
# Set these in your Cloud Host (Hugging Face Spaces Secrets / Render Environment)

# PostgreSQL Database URL (from Neon.tech or Supabase)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# JWT Secret Key
SECRET_KEY=your_generated_secret_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for Sub-100ms Whisper STT (Free from console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# RapidAPI Key for JSearch Job Discovery (Tier 2 aggregator)
RAPIDAPI_KEY=your_rapidapi_key_here

# Allowed CORS Origins (Include your Vercel URL without trailing slash)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
